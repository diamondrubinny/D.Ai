# D.Ai OS while it loads (docs/V2.md D2): the diamond on night blue, a soft throbber, and the disk
# passphrase asked here. The password-box pictures come from Debian's "spinner" theme
# (copied by the 0250-dai-boot-look hook); watermark and throbber are drawn by build/scripts/make-boot-art.py.
[Plymouth Theme]
Name=D.Ai OS
Name[he]=D.Ai OS
Description=The diamond, while D.Ai OS starts
ModuleName=two-step

[two-step]
Font=Noto Sans 12
TitleFont=Noto Sans Light 26
ImageDir=/usr/share/plymouth/themes/dai
DialogHorizontalAlignment=.5
DialogVerticalAlignment=.66
TitleHorizontalAlignment=.5
TitleVerticalAlignment=.62
HorizontalAlignment=.5
VerticalAlignment=.76
WatermarkHorizontalAlignment=.5
WatermarkVerticalAlignment=.38
Transition=none
TransitionDuration=0.0
BackgroundStartColor=0x0b1020
BackgroundEndColor=0x10173a
ProgressBarBackgroundColor=0x2a3563
ProgressBarForegroundColor=0x7c5cff
MessageBelowAnimation=true

[boot-up]
UseEndAnimation=false

[shutdown]
UseEndAnimation=false

[reboot]
UseEndAnimation=false

[updates]
SuppressMessages=true
ProgressBarShowPercentComplete=true
UseProgressBar=true
Title=Installing updates...
SubTitle=Do not turn off your computer

[system-upgrade]
SuppressMessages=true
ProgressBarShowPercentComplete=true
UseProgressBar=true
Title=Upgrading the system...
SubTitle=Do not turn off your computer
