/* ========================================================================
 * D.Ai Night — appended to the LXQt "dark" theme at image build time.
 * Tokens: docs/DESIGN.md §2. Later rules override the base theme.
 * ======================================================================== */

/* The Diamond Bar (docs/TASKBAR.md): a floating island. The panel window is
 * transparent (WA_TranslucentBackground); the bottom margin leaves a clear
 * strip under the rounded bar, the top edge catches a little light. */
LXQtPanel #BackgroundWidget {
    margin: 0 0 8px 0;
    padding: 0 6px;
    border-radius: 18px;
    border: 1px solid rgba(124, 92, 255, 38%);
    background: qlineargradient(x1: 0, y1: 0, x2: 0, y2: 1,
                                stop: 0 rgba(36, 44, 86, 92%), stop: 0.08 rgba(14, 20, 40, 90%),
                                stop: 1 rgba(11, 16, 32, 90%));
}

QToolTip {
    background: #1C2547;
    color: #E6E9F5;
    border: 1px solid #2A3563;
    border-radius: 6px;
    padding: 4px 8px;
}

Plugin > QToolButton,
Plugin > QWidget > QToolButton,
LXQtPanelPlugin > QToolButton {
    color: #E6E9F5;
    border-radius: 8px;
}

Plugin > QToolButton:hover,
Plugin > QWidget > QToolButton:hover,
LXQtPanelPlugin > QToolButton:hover {
    border: 1px solid rgba(124, 92, 255, 55%);
    background: rgba(124, 92, 255, 22%);
}

/* Start button: the D.Ai diamond (panel.conf: ownIcon). A soft violet glow
 * on hover, a cyan ring when focused from the keyboard. */
#FancyMenu {
    margin: 6px 3px;
    padding: 2px 9px;
    border: 1px solid rgba(124, 92, 255, 60%);
    border-radius: 13px;
    background: qradialgradient(cx: 0.5, cy: 0.55, radius: 0.75, fx: 0.5, fy: 0.55,
                                stop: 0 rgba(124, 92, 255, 42%), stop: 1 rgba(34, 211, 238, 6%));
    qproperty-icon: url(mainmenu.svg);
}
#FancyMenu:hover {
    border: 1px solid rgba(124, 92, 255, 70%);
    background: qradialgradient(cx: 0.5, cy: 0.5, radius: 0.7, fx: 0.5, fy: 0.5,
                                stop: 0 rgba(124, 92, 255, 55%), stop: 1 rgba(34, 211, 238, 10%));
}
#FancyMenu:pressed, #FancyMenu:checked {
    background: rgba(91, 63, 214, 80%);
    border: 1px solid #7C5CFF;
}
#FancyMenu:focus { border: 2px solid #22D3EE; }

/* Start menu window */
#FancyMenu QLineEdit {
    background: #1C2547;
    border: 1px solid #2A3563;
    border-radius: 8px;
    padding: 6px 10px;
    color: #E6E9F5;
    selection-background-color: #5B3FD6;
}
#FancyMenu QLineEdit:focus { border: 2px solid #22D3EE; }
#FancyMenu #AppView {
    border: none;
    border-radius: 8px;
    background: rgba(20, 27, 51, 92%);
    color: #E6E9F5;
}
#FancyMenu QListView::item { color: #E6E9F5; padding: 6px 4px 6px 10px; border-radius: 6px; }
#FancyMenu QListView::item:hover { background: rgba(124, 92, 255, 30%); color: #FFFFFF; }
#FancyMenu QListView::item:selected { background: #5B3FD6; color: #FFFFFF; }
#FancyMenu QToolButton:hover,
#FancyMenu QToolButton:focus { background: rgba(124, 92, 255, 30%); border: 1px solid #7C5CFF; }
#FancyMenu QToolButton:pressed { background: #5B3FD6; }

/* customcommand plugins: keyboard layout pill (and the fallback command button) */
#Custom {
    margin: 8px 3px;
    padding: 0 9px;
    border-radius: 8px;
    background: #1C2547;
    border: 1px solid #2A3563;
    color: #E6E9F5;
    font-weight: bold;
}
#Custom:hover {
    background: #5B3FD6;
    border: 1px solid #7C5CFF;
    color: #FFFFFF;
}

/* Command field next to Start (D.Ai panel plugin) */
#DaiCommand QLineEdit,
QLineEdit#DaiCommandField {
    margin: 8px 4px;
    padding: 2px 14px;
    min-width: 300px;
    border-radius: 12px;
    background: #1C2547;
    border: 1px solid #2A3563;
    color: #E6E9F5;
    selection-background-color: #5B3FD6;
}
QLineEdit#DaiCommandField:hover { border: 1px solid #7C5CFF; }
QLineEdit#DaiCommandField:focus { border: 2px solid #22D3EE; }

/* Windows as icons with light: the active one glows with the violet→cyan
 * line (task-active.svg); one that asks for attention gets an amber edge,
 * never a blinking button. */
/* Height budget: 56 (panelSize) - 8 (floating gap) - 2 (border) = 46 for every button. */
#TaskBar QToolButton {
    margin: 5px 2px;
    padding: 2px 8px;
    border-radius: 12px;
    border: 1px solid transparent;
    color: #E6E9F5;
}
#TaskBar QToolButton:hover { background: rgba(255, 255, 255, 8%); border: 1px solid #2A3563; }
#TaskBar QToolButton:on {
    border: none;
    border-image: url(task-active.svg) 0 0 0 0 stretch stretch;
}
#TaskBar QToolButton:focus { border: 2px solid #22D3EE; }
#TaskBar QToolButton[urgent="true"] { background: rgba(251, 191, 36, 18%); border: 1px solid #FBBF24; }

/* The "now" group on the right: tray, language, sound, clock, desktop, as one
 * row of matching segments (symmetric, so it reads right in Hebrew too). */
#StatusNotifierPlugin, #CustomPlugin, #VolumePlugin, #WorldClockPlugin, #ShowDesktopPlugin {
    margin: 8px 1px;
    background: #1C2547;
    border: 1px solid #2A3563;
    border-radius: 12px;
}

/* Keyboard layout, clock */
#KbIndicator > QLabel:enabled {
    color: #FFFFFF;
    background: #5B3FD6;
    border-radius: 6px;
    padding: 2px 6px;
}
#WorldClockContent { color: #E6E9F5; font-weight: bold; }
#WorldClock:hover { background: rgba(124, 92, 255, 22%); border: 1px solid rgba(124, 92, 255, 55%); border-radius: 8px; }

/* Menus and popups */
QMenu {
    background: rgba(11, 16, 32, 97%);
    border: 1px solid #2A3563;
    border-radius: 10px;
    color: #E6E9F5;
    padding: 6px;
}
QMenu::item { color: #E6E9F5; border-radius: 6px; padding: 6px 32px 6px 20px; border: none; }
QMenu::item:selected { background: #5B3FD6; color: #FFFFFF; border: none; }
QMenu::separator { background: #2A3563; height: 1px; margin: 4px 8px; }

VolumePopup { background: #141B33; border: 1px solid #2A3563; border-radius: 10px; }
VolumePopup > QSlider::add-page:vertical { background: qlineargradient(x1: 0, y1: 0, x2: 0, y2: 1, stop: 0 #7C5CFF, stop: 1 #22D3EE); border: none; }
VolumePopup > QSlider::handle:vertical { background: #FFFFFF; }

QCalendarWidget QAbstractItemView:enabled { background: #0B1020; color: #E6E9F5; selection-background-color: #5B3FD6; }
QCalendarWidget #qt_calendar_navigationbar,
QCalendarWidget #qt_calendar_navigationbar * { background-color: #141B33; color: #E6E9F5; }
