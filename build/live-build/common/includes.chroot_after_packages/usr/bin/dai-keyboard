#!/bin/sh
# SPDX-License-Identifier: Apache-2.0
# Copyright (c) 2026 Diamond Rubinny (d.Ai)
# The on-screen keyboard (wvkbd), shown and hidden (Super+Alt+K; docs/BASICS.md §2, docs/MOBILE.md A1).
# A running keyboard is toggled with SIGRTMIN (wvkbd's own toggle), so the hidden one that touch mode starts at
# login stays ready; without one, a keyboard is started.
if pkill -RTMIN -x wvkbd-mobintl 2>/dev/null; then
	exit 0
fi
command -v wvkbd-mobintl >/dev/null 2>&1 || { notify-send -a "D.Ai" "On-screen keyboard" "wvkbd is not installed"; exit 1; }
exec wvkbd-mobintl -L 260
