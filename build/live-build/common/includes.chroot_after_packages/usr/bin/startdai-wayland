#!/bin/sh
# SPDX-License-Identifier: Apache-2.0
# Copyright (c) 2026 Diamond Rubinny (d.Ai)
# D.Ai OS desktop session: LXQt on the labwc Wayland compositor.
#
# labwc runs lxqt-session as its session client (-S); lxqt-session then starts
# the panel, desktop, notifications and polkit agent from /etc/xdg/autostart
# entries marked OnlyShowIn=LXQt. Per-user labwc settings live in
# ~/.config/labwc (seeded from /etc/skel).
set -eu

: "${XDG_CONFIG_HOME:=$HOME/.config}"
: "${XDG_DATA_HOME:=$HOME/.local/share}"
: "${XDG_CACHE_HOME:=$HOME/.cache}"
: "${XDG_CONFIG_DIRS:=/etc/xdg}"
# LXQt 2.x ships its defaults (panel.conf, lxqt.conf, ...) in /usr/share/lxqt.
case ":$XDG_CONFIG_DIRS:" in
	*:/usr/share:*) ;;
	*) XDG_CONFIG_DIRS="$XDG_CONFIG_DIRS:/usr/share" ;;
esac
: "${XDG_DATA_DIRS:=/usr/local/share:/usr/share}"
export XDG_CONFIG_HOME XDG_DATA_HOME XDG_CACHE_HOME XDG_CONFIG_DIRS XDG_DATA_DIRS

# The language D.Ai speaks to this person (D.Ai Tune "language russian", docs/I18N.md §9). Only LANG and
# LANGUAGE are read, and only values that look like the ones Tune writes; anything else is ignored.
# Without a choice of their own, the computer's language counts: /etc/default/locale, which the installer
# writes from its language page (docs/I18N.md §9) and which pam_env may or may not have exported already.
language_env="$XDG_CONFIG_HOME/dai/language.env"
[ -r "$language_env" ] || case "${LANG:-}" in ""|C|C.UTF-8|C.utf8|POSIX) language_env=/etc/default/locale ;; esac
if [ -r "$language_env" ]; then
	wanted_lang=$(sed -n 's/^LANG=["]*\([a-z][a-z]_[A-Z][A-Z]\.UTF-8\)["]*$/\1/p' "$language_env" | tail -n 1)
	wanted_language=$(sed -n 's/^LANGUAGE=["]*\([a-z][a-z]:en\)["]*$/\1/p' "$language_env" | tail -n 1)
	if [ -n "$wanted_lang" ] && locale -a 2>/dev/null | grep -qix "$(printf '%s' "$wanted_lang" | sed 's/UTF-8$/utf8/')"; then
		export LANG="$wanted_lang" LC_MESSAGES="$wanted_lang"
		[ -n "$wanted_language" ] && export LANGUAGE="$wanted_language"
	fi
fi

export XDG_CURRENT_DESKTOP="LXQt:labwc:wlroots"
export XDG_SESSION_DESKTOP="LXQt"
export XDG_MENU_PREFIX="lxqt-"
export QT_QPA_PLATFORM="wayland;xcb"
export QT_QPA_PLATFORMTHEME="lxqt"
export QT_ACCESSIBILITY=1
export MOZ_ENABLE_WAYLAND=1

# Hardware cursors are often invisible in virtual machines.
if command -v systemd-detect-virt >/dev/null 2>&1 && systemd-detect-virt --quiet; then
	export WLR_NO_HARDWARE_CURSORS=1
fi

labwc_config="$XDG_CONFIG_HOME/labwc"
if [ ! -d "$labwc_config" ] && [ -d /etc/skel/.config/labwc ]; then
	mkdir -p "$XDG_CONFIG_HOME"
	cp -r /etc/skel/.config/labwc "$labwc_config"
fi

mkdir -p "$HOME/Desktop"

# First login: seed the panel with a localized Start label.
panel_conf="$XDG_CONFIG_HOME/lxqt/panel.conf"
if [ ! -e "$panel_conf" ] && [ -f /etc/xdg/lxqt/panel.conf ]; then
	mkdir -p "$XDG_CONFIG_HOME/lxqt"
	case "${LANG:-}" in
		he*) sed 's/^text=Start$/text=התחל/' /etc/xdg/lxqt/panel.conf >"$panel_conf" ;;
		*) cp /etc/xdg/lxqt/panel.conf "$panel_conf" ;;
	esac
fi

# Touch mode (docs/MOBILE.md A2): the panel's sizes follow the touch profile at every login.
if command -v dai-panel-touch >/dev/null 2>&1; then
	if python3 -c 'import sys; sys.path.insert(0, "/usr/lib/dai"); import dai_style; sys.exit(0 if dai_style.touch() else 1)' 2>/dev/null; then
		dai-panel-touch on "$panel_conf"
	else
		dai-panel-touch off "$panel_conf"
	fi
fi

exec labwc -C "$labwc_config" -S lxqt-session
