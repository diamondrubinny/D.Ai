<!-- D.Ai OS labwc configuration. Full reference: man 5 labwc-config -->
<labwc_config>
  <core>
    <decoration>server</decoration>
  </core>

  <placement>
    <policy>center</policy>
  </placement>

  <theme>
    <!-- D.Ai Night 2 (docs/LOOK.md): the "dai" theme carries the colours, shadows and the diamond buttons -->
    <name>dai</name>
    <icon>breeze-dark</icon>
    <cornerRadius>12</cornerRadius>
    <dropShadows>yes</dropShadows>
    <font place="ActiveWindow"><name>Inter</name><size>10.5</size><weight>bold</weight></font>
    <font place="InactiveWindow"><name>Inter</name><size>10.5</size><weight>normal</weight></font>
    <font place="MenuItem"><name>Inter</name><size>10.5</size></font>
    <font place="OnScreenDisplay"><name>Inter</name><size>10.5</size></font>
  </theme>

  <keyboard>
    <default />
    <numlock>on</numlock>
    <keybind key="W-space"><action name="Execute" command="dai-command" /></keybind>
    <keybind key="W-b"><action name="Execute" command="dai-forge-gui" /></keybind>
    <!-- D.Ai Voice: press once to talk, again to finish (local Whisper) -->
    <keybind key="W-h"><action name="Execute" command="dai-voice toggle --to type" /></keybind>
    <keybind key="W-S-space"><action name="Execute" command="dai-voice toggle --to command" /></keybind>
    <!-- Fix selected text typed in the wrong layout (akuo -> שלום) -->
    <!-- Switch keyboard layout (on release, so Alt+Shift+X shortcuts still work) -->
    <keybind key="A-Shift_L" onRelease="yes"><action name="Execute" command="dai-lang toggle" /></keybind>
    <keybind key="S-Alt_L" onRelease="yes"><action name="Execute" command="dai-lang toggle" /></keybind>
    <keybind key="Pause"><action name="Execute" command="dai-fixlayout" /></keybind>
    <keybind key="W-A-l"><action name="Execute" command="dai-fixlayout" /></keybind>
    <!-- D.Ai Clip: clipboard history, never passwords (docs/CLIP.md) -->
    <keybind key="W-v"><action name="Execute" command="dai-clip" /></keybind>
    <!-- D.Ai Heal: something is not working → help & repair chat (docs/EVOLVE.md §4) -->
    <keybind key="W-F1"><action name="Execute" command="dai-heal" /></keybind>
    <keybind key="W-n"><action name="Execute" command="dai-quick" /></keybind>
    <keybind key="C-S-Escape"><action name="Execute" command="dai-mom" /></keybind>
    <keybind key="W-Return"><action name="Execute" command="qterminal" /></keybind>
    <keybind key="W-e"><action name="Execute" command="pcmanfm-qt" /></keybind>
    <keybind key="W-l"><action name="Execute" command="swaylock -f" /></keybind>
    <keybind key="A-F2"><action name="Execute" command="lxqt-runner" /></keybind>
    <!-- Screenshots on Wayland (grim): the whole screen, or Shift+Print for an area (slurp) -->
    <keybind key="Print"><action name="Execute" command="dai-screenshot" /></keybind>
    <keybind key="S-Print"><action name="Execute" command="dai-screenshot --area" /></keybind>
    <!-- Copy the text in an area of the screen, read on this computer (D.Ai OCR, docs/V2.md F1) -->
    <keybind key="W-S-t"><action name="Execute" command="dai-ocr" /></keybind>
    <keybind key="XF86PowerOff"><action name="Execute" command="lxqt-leave" /></keybind>
    <!-- Toggle the Orca screen reader -->
    <keybind key="W-A-s"><action name="Execute" command="orca --replace" /></keybind>
    <!-- Screen magnifier (labwc's own): Super+= closer, Super+- back, Super+Alt+M on and off -->
    <keybind key="W-equal"><action name="ZoomIn" /></keybind>
    <keybind key="W-minus"><action name="ZoomOut" /></keybind>
    <keybind key="W-A-m"><action name="ToggleMagnify" /></keybind>
    <!-- On-screen keyboard and night light -->
    <keybind key="W-A-k"><action name="Execute" command="dai-keyboard" /></keybind>
    <keybind key="W-A-n"><action name="Execute" command="dai-nightlight" /></keybind>
    <keybind key="W-A-c"><action name="Execute" command="dai-captions" /></keybind>
    <!-- Window layouts (docs/BEYOND.md §7): Super+arrows are labwc's halves; thirds and quarters below.
         Holding Super while dragging a window also drops it into one of these regions. -->
    <keybind key="W-S-Left"><action name="ToggleSnapToRegion" region="third-left" /></keybind>
    <keybind key="W-S-Up"><action name="ToggleSnapToRegion" region="third-middle" /></keybind>
    <keybind key="W-S-Right"><action name="ToggleSnapToRegion" region="third-right" /></keybind>
    <keybind key="W-S-Down"><action name="UnSnap" /></keybind>
    <keybind key="W-C-Up"><action name="ToggleSnapToRegion" region="quarter-top-left" /></keybind>
    <keybind key="W-C-Right"><action name="ToggleSnapToRegion" region="quarter-top-right" /></keybind>
    <keybind key="W-C-Down"><action name="ToggleSnapToRegion" region="quarter-bottom-right" /></keybind>
    <keybind key="W-C-Left"><action name="ToggleSnapToRegion" region="quarter-bottom-left" /></keybind>
  </keyboard>

  <!-- Dragging a window to a screen edge snaps it to that half, with labwc's preview overlay first. -->
  <snapping>
    <range>12</range>
    <overlay><enabled>yes</enabled></overlay>
    <topMaximize>yes</topMaximize>
  </snapping>

  <regions>
    <region name="third-left" x="0%" y="0%" width="33%" height="100%" />
    <region name="third-middle" x="33%" y="0%" width="34%" height="100%" />
    <region name="third-right" x="67%" y="0%" width="33%" height="100%" />
    <region name="quarter-top-left" x="0%" y="0%" width="50%" height="50%" />
    <region name="quarter-top-right" x="50%" y="0%" width="50%" height="50%" />
    <region name="quarter-bottom-left" x="0%" y="50%" width="50%" height="50%" />
    <region name="quarter-bottom-right" x="50%" y="50%" width="50%" height="50%" />
  </regions>

  <windowRules>
    <!-- D.Ai Command draws its own frame and behaves like a popup -->
    <windowRule identifier="dai-command" serverDecoration="no" skipTaskbar="yes" skipWindowSwitcher="yes" />
    <windowRule identifier="dai-heal" serverDecoration="yes" />
    <windowRule identifier="dai-clip" serverDecoration="no" skipTaskbar="yes" skipWindowSwitcher="yes" />
    <!-- D.Ai Quick opens above the clock: bottom right, or bottom left in Hebrew (docs/TASKBAR.md §2.4) -->
    <windowRule identifier="dai-quick*" serverDecoration="no" skipTaskbar="yes" skipWindowSwitcher="yes" />
    <windowRule identifier="dai-quick">
      <action name="MoveToEdge" direction="down" snapWindows="no" />
      <action name="MoveToEdge" direction="right" snapWindows="no" />
    </windowRule>
    <windowRule identifier="dai-quick-rtl">
      <action name="MoveToEdge" direction="down" snapWindows="no" />
      <action name="MoveToEdge" direction="left" snapWindows="no" />
    </windowRule>
    <!-- D.Ai Captions: a bar at the bottom of the screen, above every window (docs/BEYOND.md §13) -->
    <windowRule identifier="dai-captions">
      <action name="MoveToEdge" direction="down" snapWindows="no" />
      <action name="ToggleAlwaysOnTop" />
    </windowRule>
  </windowRules>
</labwc_config>
