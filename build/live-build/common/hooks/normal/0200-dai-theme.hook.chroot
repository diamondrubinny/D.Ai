#!/bin/sh
# Build the "dai" LXQt theme from the packaged "dark" theme plus D.Ai overrides,
# so the image does not vendor a copy of the upstream stylesheets.
set -eu

src=/usr/share/lxqt/themes/dark
dst=/usr/share/lxqt/themes/dai
overrides=/usr/share/dai/theme

[ -d "$src" ] || { echo "dai-theme: $src not found" >&2; exit 1; }

rm -rf "$dst"
cp -a "$src" "$dst"
for sheet in lxqt-panel lxqt-notificationd; do
	cat "$overrides/$sheet.qss" >>"$dst/$sheet.qss"
done
cp /usr/share/dai/branding/dai-logo.svg "$dst/mainmenu.svg"
printf 'wallpapers/size=1\nwallpapers/1/file=/usr/share/dai/branding/wallpaper-night.jpg\n' >"$dst/wallpaper.cfg"

gtk-update-icon-cache -q -t -f /usr/share/icons/hicolor 2>/dev/null || true
