# D.Ai Server: the integrity check runs once a day (docs/SERVER.md §4, rule 8).
[Unit]
Description=Daily file-integrity check

[Timer]
OnCalendar=daily
RandomizedDelaySec=1h
Persistent=true

[Install]
WantedBy=timers.target
