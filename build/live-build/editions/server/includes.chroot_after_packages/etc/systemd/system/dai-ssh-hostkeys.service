# D.Ai Server: this server's SSH host keys, made once, before sshd starts (docs/SERVER.md §4, rule 4).
[Unit]
Description=Create this server's SSH host keys (once)
Before=ssh.service
ConditionPathExists=!/etc/ssh/ssh_host_ed25519_key

[Service]
Type=oneshot
ExecStart=/usr/bin/ssh-keygen -A
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
