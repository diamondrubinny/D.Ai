# Security headers for hosts that read this file (Cloudflare Pages, Netlify). GitHub Pages ignores it and
# serves its own headers; the pages also carry the Content-Security-Policy in a <meta> tag (docs/SITE.md).
/*
  Content-Security-Policy: default-src 'self'; img-src 'self'; style-src 'self'; script-src 'none'; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Cross-Origin-Opener-Policy: same-origin
