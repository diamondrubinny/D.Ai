# D.Ai Rescue: undo the last update of an installed D.Ai that no longer starts (run from the D.Ai USB, as root).
# -I: ignore PYTHONPATH and user site-packages.
if [ "$(id -u)" -ne 0 ]; then
	exec pkexec "$0" "$@"
fi
exec python3 -I -c 'import sys; sys.path.insert(0, "/usr/lib/dai"); from dai_tune.rescue import main; sys.exit(main(["dai-rescue", *sys.argv[1:]]))' "$@"
