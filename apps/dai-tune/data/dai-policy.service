[Unit]
Description=D.Ai organization policies (/etc/dai/policy.d)
Documentation=https://github.com/diamondrubinny/D.Ai/blob/main/docs/EDU.md
After=network-online.target
Wants=network-online.target
ConditionDirectoryNotEmpty=/etc/dai/policy.d

[Service]
Type=oneshot
ExecStart=/usr/lib/dai/dai-tune-helper policy apply
TimeoutStartSec=30min

[Install]
WantedBy=multi-user.target
