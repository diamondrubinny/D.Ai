# dai-offline-run APP -- COMMAND...: start a program with no network (docs/BEYOND.md §12). D.Ai Tune writes
# this into the app's .desktop override. bubblewrap gives the program its own network namespace with only
# the loopback device: the same files, devices (GPU), display, sound and D-Bus sockets, no way out. Without
# bubblewrap the program still starts, online, and says so.
app="$1"
if [ "$2" = "--" ]; then shift 2; else shift 1; fi
if [ -z "$app" ] || [ $# -eq 0 ]; then echo "usage: dai-offline-run APP -- COMMAND..." >&2; exit 2; fi
if command -v bwrap >/dev/null 2>&1; then
  exec bwrap --dev-bind / / --unshare-net --die-with-parent -- "$@"
fi
echo "dai-offline-run: bubblewrap is missing; $app starts with network access" >&2
exec "$@"
