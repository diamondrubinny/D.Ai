# D.Ai Move: bring files and bookmarks from Windows (installed as /usr/bin/dai-move).
# -I: ignore PYTHONPATH and user site-packages.
exec python3 -I -c 'import sys; sys.path.insert(0, "/usr/lib/dai"); from dai_move.cli import main; sys.exit(main(["dai-move", *sys.argv[1:]]))' "$@"
