# A family computer: safe by default, the apps a home needs, and a quiet evening (docs/WAY.md)
diamond: family computer
let minutes = 10

setup:
  lock the screen after $minutes minutes
  enable automatic updates
  memory saver on

apps:
  antivirus
  video-player
  printer

when:                              # user timers; the sentence runs as you, without questions
  every evening at 20:00: dark theme
  every morning at 7:00: light theme
