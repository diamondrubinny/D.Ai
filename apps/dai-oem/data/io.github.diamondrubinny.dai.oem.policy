<!DOCTYPE policyconfig PUBLIC
 "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>D.Ai OS — Diamond Rubinny (d.Ai)</vendor>
  <vendor_url>https://github.com/diamondrubinny/D.Ai</vendor_url>

  <action id="io.github.diamondrubinny.dai.oem.complete">
    <description>Finish the first-boot setup of this computer</description>
    <description xml:lang="he">סיום ההגדרה הראשונה של המחשב</description>
    <message>Authentication is required to finish the setup of this computer</message>
    <message xml:lang="he">נדרש אימות מנהל כדי לסיים את הגדרת המחשב</message>
    <icon_name>dai-logo</icon_name>
    <!-- Administrators only; 50-dai-oem.rules lets the local dai-setup session do it without a password. -->
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/lib/dai/dai-oem-helper</annotate>
  </action>
</policyconfig>
