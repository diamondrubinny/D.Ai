[Desktop Entry]
Type=Application
Name=D.Ai Rotate
Name[he]=סיבוב מסך של D.Ai
Exec=dai-rotate run
TryExec=dai-rotate
NoDisplay=true
X-GNOME-Autostart-enabled=true
