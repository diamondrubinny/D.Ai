# D.Ai Clip: clipboard history that never keeps passwords (installed as /usr/bin/dai-clip).
# -I: ignore PYTHONPATH and user site-packages.
exec python3 -I -c 'import sys; sys.path.insert(0, "/usr/lib/dai"); from dai_clip.cli import main; sys.exit(main(["dai-clip", *sys.argv[1:]]))' "$@"
